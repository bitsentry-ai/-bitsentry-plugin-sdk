{
  "name": "@bitsentry/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK contracts and validation schemas for BitSentry desktop plugins.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "keywords": [
    "bitsentry",
    "superterminal",
    "plugin",
    "sdk",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bitsentry-ai/-bitsentry-plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/bitsentry-ai/-bitsentry-plugin-sdk/issues"
  },
  "homepage": "https://github.com/bitsentry-ai/-bitsentry-plugin-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.0.8"
  }
}
